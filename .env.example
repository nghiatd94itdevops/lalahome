# For the root docker-compose.yml. Copy to .env on the VM (or have CI/CD write it from its secret store).
# Never commit .env.

# Host port the site is published on.
WEB_PORT=8000
# Real domain for canonical URLs and the sitemap, e.g. https://lalahome.vn. Empty = host of the request.
PUBLIC_SITE_URL=

# Required. Pick long random values; the database keeps them from its first start.
DB_ROOT_PASSWORD=
DB_PASSWORD=
# Required: 32+ random characters. Generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Empty key turns the AI assistant off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_DAILY_LIMIT=1000

# Proxy hops in front of the backend. 1 = only the web container (site published straight on WEB_PORT);
# 2 = web container + nginx/Caddy on the VM.
TRUST_PROXY=1

# Empty = local Piper voice only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
MAX_STREAMS=5
