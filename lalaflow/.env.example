# Copy to .env and fill in real values before deploying.
DB_ROOT_PASSWORD=rootpass
DB_PASSWORD=lalaflowpass
# Required: the backend refuses to start without a random secret of 32+ characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=LalaFlow <your-email@gmail.com>
# AI assistant on the customer site. Pick a cheap chat model that supports function calling
# (check https://openai.com/api/pricing/). Leave the key empty to turn the assistant off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
# Questions answered per day across all visitors; protects the bill if the page is abused.
CHAT_DAILY_LIMIT=1000
# Set when the backend runs behind nginx/Cloudflare so rate limits see each visitor's address, e.g. TRUST_PROXY=1
TRUST_PROXY=
